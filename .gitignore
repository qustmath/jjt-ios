# iOS 独立仓库忽略清单

# XcodeGen 产物（CI/本地按需生成，不入库）
*.xcodeproj/
*.xcworkspace/

# Xcode 用户态
xcuserdata/
*.xcuserstate

# 构建产物
DerivedData/
build/
*.ipa
*.dSYM.zip

# fastlane
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots/**/*.png
fastlane/test_output/

# 签名私钥绝不入库
*.p12
*.p8
*.mobileprovision

# 系统
.DS_Store
